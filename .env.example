# ========================================================
# ARCHISIMPLE QUOTE MAILER - CONFIGURATION D'EXPÉDITION EMAIL
# ========================================================

# Port du serveur de devis (par défaut : 3005)
PORT=3005

# --------------------------------------------------------
# OPTION 1 : API GMAIL OAUTH2 (Recommandé pour production)
# Obtenu via Google Cloud Console > API Gmail
# --------------------------------------------------------
GMAIL_USER=contact.kevinmonin@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ACCESS_TOKEN=

# --------------------------------------------------------
# OPTION 2 : GMAIL APP PASSWORD (Plus simple et immédiat)
# Généré sur myaccount.google.com/apppasswords
# Code à 16 lettres (ex: abcd efgh ijkl mnop)
# --------------------------------------------------------
GMAIL_APP_PASSWORD=

# --------------------------------------------------------
# HUBSPOT API (Facultatif - si webhook autonome)
# --------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=
